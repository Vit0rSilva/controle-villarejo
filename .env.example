# Database (5432 padrão ou 5433 quando usando o container villarejo-postgres via docker-compose)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>

# Evolution API Configuration
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=vitinho
EVOLUTION_INSTANCE_TOKEN=REDACTED_MIGRATION_VALUE
EVOLUTION_WEBHOOK_TOKEN=REDACTED_MIGRATION_VALUE
REQUIRE_WEBHOOK_TOKEN=true
TARGET_GROUP_JID=557188908550-1544726594@g.us
WEBHOOK_PUBLIC_URL=http://villarejo-api:8000/api/v1/webhook/evolution

# Application
APP_ENV=development
STALE_SECTION_HOURS=24
FUZZY_MATCH_THRESHOLD=82
AUTO_SEED_ON_STARTUP=true

NUTRICAO_WEB_SEARCH_URL=
BRAVE_SEARCH_API_KEY=REDACTED_MIGRATION_VALUE
